{
  "name": "padosipro",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @padosipro/api dev",
    "dev:mobile": "pnpm --filter @padosipro/mobile start",
    "build:api": "pnpm --filter @padosipro/api build",
    "start:api": "pnpm --filter @padosipro/api start",
    "test": "pnpm --filter @padosipro/api test",
    "db:migrate": "pnpm --filter @padosipro/api prisma:migrate",
    "db:seed": "pnpm --filter @padosipro/api prisma:seed",
    "db:generate": "pnpm --filter @padosipro/api prisma:generate",
    "render:build": "pnpm install --frozen-lockfile && pnpm exec prisma generate --schema apps/api/prisma/schema.prisma",
    "render:start": "pnpm exec prisma migrate deploy --schema apps/api/prisma/schema.prisma && pnpm exec tsx apps/api/prisma/seed.ts && pnpm exec tsx apps/api/src/index.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
