{
  "name": "padosipro",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @padosipro/api dev",
    "dev:mobile": "pnpm --filter @padosipro/mobile start",
    "build:api": "pnpm --filter @padosipro/api build",
    "start:api": "pnpm --filter @padosipro/api start",
    "test": "pnpm --filter @padosipro/api test",
    "db:migrate": "pnpm --filter @padosipro/api prisma:migrate",
    "db:seed": "pnpm --filter @padosipro/api prisma:seed",
    "db:generate": "pnpm --filter @padosipro/api prisma:generate",
    "render:build": "pnpm install --frozen-lockfile && pnpm --filter @padosipro/api exec prisma generate",
    "render:start": "pnpm --filter @padosipro/api exec prisma migrate deploy && pnpm --filter @padosipro/api exec prisma db seed && pnpm --filter @padosipro/api start"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "esbuild"
    ]
  }
}
