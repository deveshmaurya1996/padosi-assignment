DATABASE_URL=postgresql://padosi:padosi@localhost:5432/padosipro?schema=public
# Render: set automatically from the linked Postgres (Internal Database URL)

# API
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_MS=2592000000
CORS_ORIGIN=*

# Local Mailpit (docker compose):
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="PadosiPro <noreply@padosipro.local>"

# Resend (APK / Render) — SMTP_PASS is the Resend API key. Sends over HTTPS api.resend.com.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
EMAIL_FROM="PadosiPro <noreply@dartix.live>"

EXPO_PUBLIC_API_URL=http://localhost:3000
