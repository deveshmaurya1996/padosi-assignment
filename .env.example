# Database
DATABASE_URL=postgresql://padosi:padosi@localhost:5432/padosipro?schema=public

# API
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# SMTP (Mailpit defaults — see docker-compose.yml)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="PadosiPro <noreply@padosipro.local>"

# Mobile (apps/mobile/.env or app config)
EXPO_PUBLIC_API_URL=http://localhost:3000
